# Copy to .env and fill in your API key and Google Sheets settings.
# The same key can be used by the existing chatbot backend.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_STT_MODEL=gpt-transcribe

# Text model settings, reused from the chatbot project.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium

# Authenticated sessions and SQLite. Relative paths start at the VoiceBridge project directory.
SESSION_TTL_SECONDS=86400
DATABASE_PATH=instance/voicebridge.sqlite3

# Google Sheets settings.
# Use the path to the existing service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
SPREADSHEET_ID=replace_with_your_spreadsheet_id
SHEET_NAME=Logs

# Optional Flask settings; these defaults also work without adding them to .env.
HOST=127.0.0.1
PORT=5003

# Google Sign-In
GOOGLE_CLIENT_ID=replace_with_your_web_client_id
